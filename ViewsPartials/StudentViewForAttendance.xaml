<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SystemOfDrawingStudentForAnswering.ViewsPartials.StudentViewForAttendance"
             xmlns:models="clr-namespace:SystemOfDrawingStudentForAnswering.Models"
             StyleId="StudentViewForAttendance"
             x:DataType="models:Student">
    <HorizontalStackLayout>
        <Label Text="{Binding Name}" />
        <Label Text="{Binding Surname}" />
        <Label Text="Obecny/a"/>
        <CheckBox IsChecked="{Binding IsPresent}" />
    </HorizontalStackLayout>
</ContentView>