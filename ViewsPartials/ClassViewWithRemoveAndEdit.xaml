<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SystemOfDrawingStudentForAnswering.ViewsPartials.ClassViewWithRemoveAndEdit"
             xmlns:models="clr-namespace:SystemOfDrawingStudentForAnswering.Models"
             xmlns:partials="clr-namespace:SystemOfDrawingStudentForAnswering.ViewsPartials"
             xmlns:viewModels="clr-namespace:SystemOfDrawingStudentForAnswering.ViewModels"
             x:DataType="viewModels:AllClasses"
             StyleId="ClassViewWithRemoveAndEdit">
    <ScrollView>
        <VerticalStackLayout>
        <Label Text="{Binding ClassFromPicker.Name}"/>
        <ListView ItemsSource="{Binding ClassFromPicker.Students}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout>
                            <partials:StudentViewWithRemoveAndEdit/>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
    </ScrollView>
</ContentView>
