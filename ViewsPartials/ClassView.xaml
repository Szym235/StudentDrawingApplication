<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SystemOfDrawingStudentForAnswering.ViewsPartials.ClassView"
             xmlns:models="clr-namespace:SystemOfDrawingStudentForAnswering.Models"
             xmlns:partials="clr-namespace:SystemOfDrawingStudentForAnswering.ViewsPartials"
             xmlns:viewModels="clr-namespace:SystemOfDrawingStudentForAnswering.ViewModels"
             StyleId="ClassView"
             x:DataType="viewModels:AllClasses">
    <ScrollView>
    <VerticalStackLayout>
        <Label Text="{Binding ClassFromPicker.Name}"/>
        <ListView ItemsSource="{Binding ClassFromPicker.Students}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout>
                            <partials:StudentView/>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
    </ScrollView>
</ContentView>
